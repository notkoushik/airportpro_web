export interface PassportData {
  documentType: string;
  countryCode: string;
  surname: string;
  givenNames: string;
  passportNumber: string;
  nationality: string;
  dateOfBirth: string;
  dateOfExpiry: string;
  sex: string;
  personalNumber?: string;
  rawMRZ?: string;
}

/**
 * Parses ICAO 9303 Machine-Readable Zone from passport
 * @param mrzText Raw text containing 2 MRZ lines
 * @returns PassportData object or null if parsing fails
 */
export function parseICAOMRZ(mrzText: string): PassportData | null {
  try {
    console.log('🔍 Starting ICAO MRZ parsing...');
    
    // Extract and clean MRZ lines
    const lines = mrzText
      .split('\n')
      .map(line => cleanMRZLine(line))
      .filter(line => line.length >= 30); // At least 30 chars (flexible)
    
    if (lines.length < 2) {
      console.error('❌ Need at least 2 MRZ lines, got:', lines.length);
      return null;
    }
    
    const line1 = lines[0].padEnd(44, '<');
    const line2 = lines[1].padEnd(44, '<');
    
    console.log('✅ Cleaned Line 1:', line1);
    console.log('✅ Cleaned Line 2:', line2);
    
    // Parse Line 1: P<COUNTRYCODE<SURNAME<<GIVENNAMES
    const documentType = line1.charAt(0);
    const countryCode = line1.substring(2, 5).replace(/</g, '');
    const nameField = line1.substring(5);
    const { surname, givenNames } = parseNameField(nameField);
    
    // Parse Line 2: PASSPORTNUMBER<NATIONALITYDOB<SEXEXPIRY<PERSONALNUM<<<
    const passportNumber = extractField(line2, 0, 9);
    const nationality = extractField(line2, 10, 13);
    const dobRaw = line2.substring(13, 19);
    const sex = line2.charAt(20);
    const expiryRaw = line2.substring(21, 27);
    const personalNumber = extractField(line2, 28, 42);
    
    // Convert dates
    const dateOfBirth = convertMRZDate(dobRaw);
    const dateOfExpiry = convertMRZDate(expiryRaw);
    
    return {
      documentType,
      countryCode,
      surname,
      givenNames,
      passportNumber,
      nationality: getCountryName(nationality || countryCode),
      dateOfBirth,
      dateOfExpiry,
      sex,
      personalNumber: personalNumber || undefined,
      rawMRZ: `${line1}\n${line2}`
    };
    
  } catch (error) {
    console.error('❌ MRZ parse error:', error);
    return null;
  }
}

/**
 * CRITICAL FIX: Only remove invalid characters, DON'T replace O/I
 * Previous version was converting "GOUD" to "G0UD" ❌
 * This version preserves real names ✅
 */
function cleanMRZLine(line: string): string {
  return line
    .toUpperCase()
    .replace(/\s/g, '')  // Remove all spaces
    .replace(/[^A-Z0-9<]/g, '<');  // Replace invalid chars with <
    // NOTE: We do NOT convert O->0 or I->1 here!
    // Those conversions destroy real names like "GOUD", "INDIA"
}

/**
 * Parse name field with proper << delimiter handling
 * Format: SURNAME<<GIVENNAME<GIVENNAME2
 */
function parseNameField(nameField: string): { surname: string; givenNames: string } {
  const cleaned = nameField.replace(/<+$/, ''); // Remove trailing <
  
  if (cleaned.includes('<<')) {
    // Standard format: SURNAME<<GIVENNAMES
    const parts = cleaned.split('<<');
    return {
      surname: parts[0].replace(/</g, ' ').trim() || 'UNKNOWN',
      givenNames: (parts[1] || '').replace(/</g, ' ').trim() || 'UNKNOWN'
    };
  }
  
  // Fallback: single < separator
  const parts = cleaned.split('<').filter(p => p.length > 0);
  return {
    surname: parts[0] || 'UNKNOWN',
    givenNames: parts.slice(1).join(' ') || 'UNKNOWN'
  };
}

/**
 * Extract field and remove filler characters
 */
function extractField(line: string, start: number, end: number): string {
  if (start >= line.length) return '';
  const actualEnd = Math.min(end, line.length);
  return line.substring(start, actualEnd).replace(/</g, '').trim();
}

/**
 * Convert MRZ date (YYMMDD) to DD/MM/YYYY
 * Example: "000108" -> "08/01/2000"
 *          "301220" -> "20/12/2030"
 */
function convertMRZDate(yymmdd: string): string {
  if (yymmdd.length !== 6) return 'Invalid Date';
  
  try {
    const yy = parseInt(yymmdd.substring(0, 2), 10);
    const mm = parseInt(yymmdd.substring(2, 4), 10);
    const dd = parseInt(yymmdd.substring(4, 6), 10);
    
    if (isNaN(yy) || isNaN(mm) || isNaN(dd)) return 'Invalid Date';
    if (mm < 1 || mm > 12 || dd < 1 || dd > 31) return 'Invalid Date';
    
    // Determine full year
    // If YY > current year's last 2 digits, assume 19xx, else 20xx
    const currentYearLastTwo = new Date().getFullYear() % 100;
    const fullYear = yy > currentYearLastTwo ? 1900 + yy : 2000 + yy;
    
    return `${dd.toString().padStart(2, '0')}/${mm.toString().padStart(2, '0')}/${fullYear}`;
  } catch {
    return 'Invalid Date';
  }
}

/**
 * Get full country name from 3-letter code
 */
function getCountryName(code: string): string {
  const countries: Record<string, string> = {
    'IND': 'India',
    'USA': 'United States',
    'GBR': 'United Kingdom',
    'CAN': 'Canada',
    'AUS': 'Australia',
    'DEU': 'Germany',
    'FRA': 'France',
    'CHN': 'China',
    'JPN': 'Japan',
    'KOR': 'South Korea',
    'NPL': 'Nepal',
    'BGD': 'Bangladesh',
    'PAK': 'Pakistan',
    'LKA': 'Sri Lanka',
    'SGP': 'Singapore',
    'ARE': 'United Arab Emirates',
    'SAU': 'Saudi Arabia',
    'THA': 'Thailand',
    'MYS': 'Malaysia',
    'IDN': 'Indonesia',
  };
  return countries[code] || code || 'Unknown';
}

/**
 * EXAMPLE USAGE:
 * 
 * const mrzText = `
 * P<INDTALLAPALLY<<ARAVIND<GOUD<<
 * UB200460<21ND0001085M30122028063154380320<78
 * `;
 * 
 * const passportData = parseICAOMRZ(mrzText);
 * 
 * Expected Output:
 * {
 *   documentType: "P",
 *   countryCode: "IND",
 *   surname: "TALLAPALLY",
 *   givenNames: "ARAVIND GOUD",
 *   passportNumber: "UB200460",
 *   nationality: "India",
 *   dateOfBirth: "08/01/2000",
 *   dateOfExpiry: "20/12/2030",
 *   sex: "M",
 *   personalNumber: "2063154380320"
 * }
 */